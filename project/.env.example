# Copy to .env and fill in.

# ---------------------------------------------------------------- Supabase
# Used only for email sign-in. Leave as-is to use the built-in local mock
# (accounts stored in your browser), which is enough to run the project.
# Use the anon / publishable key, never the service_role / secret key.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------- ArtChain
# The node the website talks to. Start the network with `npm start` in server/.
VITE_NODE_URL=http://localhost:4001
