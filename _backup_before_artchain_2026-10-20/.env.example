# Copy to .env and fill in. The backend reads this same file (../.env),
# so you only need one copy at project/.env.

# ---------------------------------------------------------------- Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# -------------------------------------------------------------- Blockchain
# Sepolia JSON-RPC endpoint (Alchemy, Infura, or a public node).
# VITE_ prefix is required for the browser to see it.
VITE_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_key
# Same endpoint for Hardhat and the deploy script (optional if the above is set).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_key

# Relayer key: signs registrations for users who have no wallet.
# Must hold Sepolia ETH. NEVER use a key that holds real funds.
PRIVATE_KEY=your_private_key_without_0x_prefix

# Address printed by scripts/deploy.ts. Both names are read; set at least the
# VITE_ one so the frontend can talk to the contract directly.
VITE_CONTRACT_ADDRESS=0x...
CONTRACT_ADDRESS=0x...

# ----------------------------------------------------------------- Backend
SERVER_PORT=3001
VITE_BACKEND_URL=http://localhost:3001
